<controls:ProWindow x:Class="DuckDBGeoparquet.Views.AddSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        Title="Add GeoParquet Data Source"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap"
                   Text="Save any GeoParquet URL (http(s):// or s3://, wildcards allowed) as a reusable data source. It is validated now and appears under Custom Sources in the Overture Maps Data Loader." />

        <TextBlock Grid.Row="1" Margin="0,10,0,2" Style="{DynamicResource Esri_TextBlockRegular}" Text="Name" />
        <TextBox Grid.Row="2" x:Name="NameBox" />

        <TextBlock Grid.Row="3" Margin="0,8,0,2" Style="{DynamicResource Esri_TextBlockRegular}" Text="URL" />
        <TextBox Grid.Row="4" x:Name="UrlBox" />

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusBlock" Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="AddButton" Content="Add" MinWidth="70" Margin="8,0,0,0"
                    Style="{DynamicResource Esri_Button}" Click="OnAddClick" IsDefault="True" />
            <Button Grid.Column="2" Content="Close" MinWidth="70" Margin="8,0,0,0"
                    Style="{DynamicResource Esri_Button}" Click="OnCloseClick" IsCancel="True" />
        </Grid>
    </Grid>
</controls:ProWindow>
