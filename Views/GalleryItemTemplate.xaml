<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions">
    <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Provider dataset tiles: wider than the stock 48px template because
         preset names ("US Structures from ORNL") need two wrapped lines. -->
    <DataTemplate x:Key="ProviderDatasetItemTemplate">
        <Grid Width="84" Height="64" Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding Icon}" Stretch="None"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" MaxWidth="82" Text="{Binding Text}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       TextAlignment="Center" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
